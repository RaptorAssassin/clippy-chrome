{
    "manifest_version": 3,
    "name": "Clippy",
    "version": "1.0.0",
    "description": "Clippy is back, and better than ever before! He gives you cool hints everytime you visit a website.",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "scripts": ["background/service-worker.js"],
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "permissions": ["webNavigation", "storage"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content/clippy-injection.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {

            "resources": ["content/clippy.html", "content/clippy-frame.js", "anims/*.webm", "content/clippy.css", "icons/clippy-icon.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "icons": {
        "48": "icons/clippy48.png",
        "128": "icons/clippy128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "clippy@example.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}