{
    "manifest_version": 3,
    "name": "Clippy Chrome Extension",
    "version": "0.1.0",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "permissions": ["webNavigation"],
    "host_permissions": ["<all_urls>"],
    "icons": {
        "16": "icons/clippy-icon.png",
        "48": "icons/clippy-icon.png",
        "128": "icons/clippy-icon.png"
    }
}