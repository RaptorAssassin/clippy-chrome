{
    "manifest_version": 3,
    "name": "Clippy Chrome Extension",
    "version": "0.1.0",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "permissions": ["webNavigation", "storage"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content/clippy-injection.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {

            "resources": ["content/clippy.html", "content/clippy-frame.js", "anims/*.webm", "content/clippy.css", "icons/clippy-icon.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "icons": {
        "16": "icons/clippy-icon.png",
        "48": "icons/clippy-icon.png",
        "128": "icons/clippy-icon.png"
    }
}